{
	"name": "vendor-src",
	"version": "0.0.0",
	"description": "Vendor dependency source into your repo with git subtree, pinned to the installed version, for coding agents.",
	"keywords": true,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/KATT/vendor-src.git"
	},
	"license": "MIT",
	"author": {
		"name": "KATT",
		"email": "alexander@n1s.se"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./dist/index.mjs"
	},
	"bin": "./lib/bin.js",
	"files": [
		"dist/"
	],
	"scripts": {
		"build": "tsdown",
		"format": "prettier .",
		"lint": "eslint . --max-warnings 0",
		"prepare": "husky",
		"test": "vitest"
	},
	"lint-staged": {
		"*": "prettier --ignore-unknown --write"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@release-it/conventional-changelog": "12.0.0",
		"@types/node": "26.6.2",
		"@vitest/coverage-v8": "5.0.1",
		"@vitest/eslint-plugin": "1.6.27",
		"console-fail-test": "0.9.0",
		"eslint": "10.12.0",
		"husky": "9.1.7",
		"lint-staged": "17.6.0",
		"prettier": "^3.9.6",
		"release-it": "21.1.0",
		"tsdown": "0.23.0",
		"typescript": "5.9.3",
		"typescript-eslint": "8.71.0",
		"vitest": "5.0.1"
	},
	"packageManager": "pnpm@11.22.0",
	"engines": {
		"node": "^22.13.0 || ^24.11.0 || >=26.0.0"
	}
}
