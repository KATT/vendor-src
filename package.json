{
	"name": "vendor-src-workspace",
	"private": true,
	"description": "Workspace root for vendor-src",
	"type": "module",
	"scripts": {
		"build": "vp -C packages/vendor-src pack",
		"docs": "node packages/vendor-src/scripts/readme.ts",
		"format": "vp fmt",
		"format:check": "vp fmt --check",
		"lint": "vp lint --disable-nested-config --ignore-pattern=.repos/** --ignore-pattern=**/node_modules/**",
		"lint:fix": "vp lint --fix --disable-nested-config --ignore-pattern=.repos/** --ignore-pattern=**/node_modules/**",
		"prepare": "husky",
		"test": "vp -C packages/vendor-src test",
		"typecheck": "pnpm --filter vendor-src typecheck",
		"check": "vp check",
		"postinstall": "node ./scripts/workspace-check.mjs"
	},
	"devDependencies": {
		"@release-it/conventional-changelog": "12.0.2",
		"@types/node": "26.6.4",
		"@vitest/coverage-v8": "5.0.1",
		"husky": "9.1.7",
		"lint-staged": "17.6.0",
		"oxfmt": "0.70.0",
		"release-it": "21.1.0",
		"typescript": "7.0.2",
		"vendor-src": "workspace:*",
		"vite-plus": "1.0.0"
	},
	"lint-staged": {
		"*": "vp fmt --no-error-on-unmatched-pattern"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@12.9.1"
}
