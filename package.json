{
	"name": "vendor-src",
	"version": "0.0.0",
	"description": "Vendor dependency source into your repo with git subtree, pinned to the installed version, for coding agents.",
	"keywords": [
		"agents",
		"git-subtree",
		"vendor",
		"coding-agents"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/KATT/vendor-src.git"
	},
	"license": "MIT",
	"author": {
		"name": "KATT",
		"email": "alexander@n1s.se"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./dist/index.mjs"
	},
	"bin": {
		"vendor-src": "./dist/bin.mjs"
	},
	"files": [
		"dist/"
	],
	"scripts": {
		"build": "tsdown",
		"format": "oxfmt",
		"lint": "oxlint",
		"prepare": "husky",
		"test": "vitest",
		"format:check": "oxfmt --check",
		"lint:fix": "oxlint --fix",
		"typecheck": "tsc"
	},
	"lint-staged": {
		"*": "oxfmt --no-error-on-unmatched-pattern"
	},
	"devDependencies": {
		"@release-it/conventional-changelog": "12.0.2",
		"@types/node": "26.6.4",
		"@vitest/coverage-v8": "5.0.3",
		"console-fail-test": "0.9.0",
		"husky": "9.1.7",
		"lint-staged": "17.6.0",
		"oxfmt": "^0.72.0",
		"oxlint": "^1.87.0",
		"release-it": "21.1.0",
		"tsdown": "0.23.0",
		"typescript": "7.0.2",
		"vitest": "5.0.3"
	},
	"packageManager": "pnpm@12.9.1",
	"engines": {
		"node": ">=24"
	},
	"dependencies": {
		"@effect/platform-node": "4.0.1",
		"effect": "4.0.1"
	}
}
