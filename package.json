{
	"name": "vendor-src",
	"version": "0.2.0",
	"description": "Vendor dependency source into your repo with git subtree, pinned to the installed version, for coding agents.",
	"keywords": [
		"agents",
		"coding-agents",
		"git-subtree",
		"vendor"
	],
	"license": "MIT",
	"author": {
		"name": "KATT",
		"email": "alexander@n1s.se"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/KATT/vendor-src.git"
	},
	"bin": {
		"vendor-src": "./bin/vendor-src.js"
	},
	"files": [
		"bin/",
		"dist/",
		"schema/",
		"scripts/"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": "./dist/index.mjs",
		"./schema.json": "./schema/vendor-src.schema.json"
	},
	"scripts": {
		"build": "vp pack",
		"format": "vp fmt",
		"format:check": "vp fmt --check",
		"lint": "vp lint --disable-nested-config --ignore-pattern=repos/**",
		"lint:fix": "vp lint --fix --disable-nested-config --ignore-pattern=repos/**",
		"prepare": "husky",
		"test": "vp test",
		"typecheck": "tsc",
		"check": "vp check",
		"postinstall": "node ./scripts/postinstall-check.mjs"
	},
	"dependencies": {
		"@effect/platform-node": "4.0.1",
		"effect": "4.0.1"
	},
	"devDependencies": {
		"@release-it/conventional-changelog": "12.0.2",
		"@types/node": "26.6.4",
		"@vitest/coverage-v8": "5.0.1",
		"husky": "9.1.7",
		"lint-staged": "17.6.0",
		"oxfmt": "0.70.0",
		"release-it": "21.1.0",
		"typescript": "7.0.2",
		"vite-plus": "1.0.0"
	},
	"lint-staged": {
		"*": "vp fmt --no-error-on-unmatched-pattern"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@12.9.1"
}
